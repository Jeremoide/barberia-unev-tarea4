    decimal subtotal
    decimal descuento
    decimal impuesto
    decimal total
    varchar metodo
    decimal recibido
    decimal cambio
    varchar estado
    varchar motivo
  }
  venta_detalles {
    bigint id PK
    bigint venta_id FK
    bigint lote_id FK
    int cantidad
    decimal precio
  }
