    bigint id PK
    bigint usuario_id FK
    datetime apertura
    datetime cierre
    decimal fondo
    decimal esperado
    decimal contado
    decimal diferencia
  }
  categorias_servicio {
    bigint id PK
    varchar nombre
    varchar descripcion
  }
